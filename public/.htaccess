Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# Fallback 404
ErrorDocument 404 /404/index.html

# Enable Rewrite Engine for Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization Header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Legacy URLs -> Redirect to landing page anchors (301)
  RewriteRule ^empresa/?$ /#empresa [R=301,NE,L]
  RewriteRule ^produtos/?$ /#produtos [R=301,NE,L]
  RewriteRule ^tecnologia/?$ /#tecnologia [R=301,NE,L]
  RewriteRule ^certificacoes/?$ /#certificacoes [R=301,NE,L]
  RewriteRule ^compliance/?$ /#compliance [R=301,NE,L]
  RewriteRule ^contato/?$ /#contato [R=301,NE,L]
  RewriteRule ^diferenciais/?$ /#diferenciais [R=301,NE,L]
  RewriteRule ^localizacao/?$ /#localizacao [R=301,NE,L]
  RewriteRule ^equipe/?$ /#equipe [R=301,NE,L]
  RewriteRule ^video/?$ /#video [R=301,NE,L]

  # 1. If file exists directly, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If request has .html extension and folder/index.html exists, serve folder/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)\.html$ $1/index.html [L]

  # 3. If request is a clean path and folder/index.html exists, serve folder/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 4. If directory exists directly, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

